import tkinter as tk
import math

# Ventana
root = tk.Tk()
root.title("Hola Mundo Neón")
root.geometry("600x300")
root.configure(bg="black")
root.resizable(False, False)

canvas = tk.Canvas(root, width=600, height=300, bg="black", highlightthickness=0)
canvas.pack()

# Texto principal
text = canvas.create_text(
    300, 150,
    text="HOLA MUNDO",
    fill="#00f6ff",
    font=("Arial Black", 40)
)

# Efecto glow (capas)
glow_layers = []
for i in range(1, 6):
    glow = canvas.create_text(
        300, 150,
        text="HOLA MUNDO",
        fill="#00f6ff",
        font=("Arial Black", 40 + i)
    )
    glow_layers.append(glow)

angle = 0

def animate():
    global angle
    angle += 0.08

    # Movimiento flotante
    y_offset = math.sin(angle) * 10

    for i, glow in enumerate(glow_layers):
        canvas.coords(glow, 300, 150 + y_offset)
        canvas.itemconfig(glow, fill="#00f6ff")

    canvas.coords(text, 300, 150 + y_offset)

    root.after(30, animate)

animate()
root.mainloop()
